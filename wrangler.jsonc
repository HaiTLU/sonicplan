// Sonicplan: một Worker lo cả giao diện, API và hẹn giờ.
// Dữ liệu ở D1, đăng nhập bằng Cloudflare Access. Hướng dẫn cài: README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonicplan",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "observability": { "enabled": true },
  "preview_urls": false,

  // Địa chỉ trang. Khi triển khai, Cloudflare tự tạo bản ghi DNS và chứng chỉ cho tên miền này
  // (tên miền sonicrec.app phải nằm trong cùng tài khoản Cloudflare).
  // Tắt địa chỉ *.workers.dev để chỉ có một cửa vào, cửa này được Access bảo vệ.
  "routes": [{ "pattern": "plan.sonicrec.app", "custom_domain": true }],
  "workers_dev": false,

  // Chỉ API, địa chỉ nhận tin và lịch đi qua Worker. Trang tĩnh (html, css, js, phông) do Cloudflare phát thẳng
  // từ biên gần người dùng, không đánh thức Worker; Access vẫn đứng trước cả tên miền nên vẫn phải đăng nhập.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/nhan/*", "/lich/*"],
    "not_found_handling": "single-page-application"
  },

  // Cơ sở dữ liệu tạo ngày 11/10/2026, vùng châu Á - Thái Bình Dương.
  "d1_databases": [
    {
      "binding": "CSDL",
      "database_name": "tro-ly-rieng", // tên đặt trước khi có tên công ty; D1 không đổi tên được
      "database_id": "1eda092c-b538-4bb0-bb39-e660cf027338",
      "migrations_dir": "migrations"
    }
  ],

  // Kho tệp đính kèm và bản sao lưu hằng đêm (cần bật R2 trong trang Cloudflare, README bước 2).
  "r2_buckets": [{ "binding": "TEP", "bucket_name": "sonicplan-tep" }],

  // Workers AI để tách việc và tóm tắt tin, không cần khóa ngoài.
  "ai": { "binding": "AI" },

  // Giờ UTC. 16:00 UTC = 23:00 giờ Việt Nam. Tác vụ nào chạy ở lịch nào: src/lich-chay.js.
  "triggers": {
    "crons": ["*/5 * * * *", "0 * * * *", "0 16 * * *"]
  },

  "vars": {
    // Tên miền nhóm Access, dạng ten-nhom.cloudflareaccess.com (README bước 5).
    "ACCESS_TEAM_DOMAIN": "autumn-bar-9932.cloudflareaccess.com",
    // Mã AUD của ứng dụng Access (README bước 5).
    "ACCESS_AUD": "3c6d37c2645cc2d9276921c4684b8a5e9a175f346ee93b79ff1736910e161f1c",
    // Tên miền nhận thư qua Email Routing, ví dụ "sonicplan.vn". Để trống thì chưa nhận thư.
    "EMAIL_DOMAIN": "sonicrec.app",
    // Người quản trị hệ thống (cài bot Telegram chung ở trang Kết nối), nhiều email cách nhau dấu phẩy.
    // Bot chung được dán ngay trong trang, mã hóa bằng bí mật KHOA_MA_HOA rồi lưu trong D1.
    "QUAN_TRI": "hainnam@gmail.com",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
